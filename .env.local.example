# Supabase (대시보드 → Project Settings → API 에서 복사)
# 이 두 개는 브라우저에 노출되는 공개 값이라 그대로 커밋해도 되지만,
# .env.local 은 .gitignore 에 있으니 실제 값은 여기 말고 .env.local 에 넣는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키는 이 앱에 필요 없다.
# 익명 로그인 + RLS 로 접근을 제어하므로 서버에서도 anon 키만 쓴다.
# 혹시 나중에 관리 작업이 필요해지면 그때 추가하되, 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
